function trial() { submit_(['Digital-01', 'Manual-01']); }
function runAll() { submit_(RECORDS.map(r => r.id)); }

function submit_(ids) {
  const form = FormApp.openById(FORM_ID);
  const done = JSON.parse(PropertiesService.getScriptProperties().getProperty('done') || '[]');
  const items = form.getItems();
  const byTitle = p => items.find(i => i.getTitle().startsWith(p));
  const mc = (title, value) => {
    if (value == null) return null;
    value = value.replace('-', '–');
    if (/^\d+–\d+$/.test(value) && title.startsWith('Length')) value += ' years';
    const item = items.find(i => i.getTitle() === title || i.getTitle().startsWith(title));
    return item.asMultipleChoiceItem().createResponse(value);
  };
  const sections = [['Section B', 0, 7], ['Section C', 7, 6], ['Section D', 13, 6], ['Section E', 19, 7]];
  const start = Date.now();
  const todo = RECORDS.filter(r => ids.includes(r.id) && !done.includes(r.id) && r.age && r.svc && r.job);
  for (const r of todo) {
    if (Date.now() - start > 270000) { Logger.log('Time guard: run again to continue.'); break; }
    const resp = form.createResponse();
    [mc('Response mode', r.mode), mc('Section A', r.q1), mc('Age group', r.age),
     mc('Length of service', r.svc), mc('Job level', r.job)]
      .forEach(x => { if (x) resp.withItemResponse(x); });
    sections.forEach(([p, s, n]) => {
      const rows = r.a.slice(s, s + n).map(v => LABELS[v - 1]);
      resp.withItemResponse(byTitle(p).asGridItem().createResponse(rows));
    });
    resp.submit();
    done.push(r.id);
    PropertiesService.getScriptProperties().setProperty('done', JSON.stringify(done));
    Logger.log('submitted ' + r.id);
  }
  Logger.log('Done so far: ' + done.length + ' of 103');
}

function status() {
  Logger.log('Recorded as submitted: ' + JSON.parse(PropertiesService.getScriptProperties().getProperty('done') || '[]').length +
             ' | form responses: ' + FormApp.openById(FORM_ID).getResponses().length);
}

function clearDone() {
  PropertiesService.getScriptProperties().deleteProperty('done');
  Logger.log('Cleared the submitted-IDs list. Form responses now: ' + FormApp.openById(FORM_ID).getResponses().length);
}
